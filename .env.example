# =============================================================================
# ตัวอย่างไฟล์ environment — คัดลอกเป็น .env.local แล้วเติมค่าจริง
#
# ห้าม commit ไฟล์ .env หรือ .env.local เข้า repository ไม่ว่ากรณีใด (ข้อ 14.1)
# ไฟล์นี้ระบุเฉพาะ "ชื่อ" ตัวแปร ห้ามใส่ค่าจริงลงไป
# =============================================================================

# URL ของแอปพลิเคชัน ใช้สร้างลิงก์ในอีเมลและ redirect ของ auth
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — ดูค่าได้จาก Project Settings > API
# anon key เป็น public key ตามการออกแบบของ Supabase และอยู่ใต้ RLS เสมอ
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service-role key ข้าม RLS ทั้งหมด
# ตั้งเฉพาะใน Vercel/Supabase environment ของฝั่ง server เท่านั้น
# ห้ามตั้งชื่อขึ้นต้นด้วย NEXT_PUBLIC_ และห้ามอ้างถึงใน client component
SUPABASE_SERVICE_ROLE_KEY=

# Error monitoring (ไม่บังคับใน local)
SENTRY_DSN=

# ค่าคงที่ของระบบ
APP_TIMEZONE=Asia/Bangkok
DOCUMENT_STORAGE_BUCKET=issued-documents
ATTACHMENT_STORAGE_BUCKET=attachments

# commit SHA สำหรับแสดงในหน้าผู้ดูแล — Vercel ตั้งให้อัตโนมัติจาก VERCEL_GIT_COMMIT_SHA
APP_COMMIT_SHA=local
